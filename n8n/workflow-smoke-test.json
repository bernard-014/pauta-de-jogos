{
  "name": "smoke-test-pauta",
  "nodes": [
    {
      "parameters": {},
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "879dfb99-0d66-4463-8c40-2187f9141a7a"
    },
    {
      "parameters": {
        "url": "=https://api.football-data.org/v4/matches",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Auth-Token",
              "value": "={{ $env.FOOTBALL_DATA_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "name": "FootballData",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        0
      ],
      "id": "c8d07dd8-4f7d-4f4d-98a4-91c3b2d2b5ec"
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getChat?chat_id={{ $env.TELEGRAM_CHAT_ID }}",
        "options": {}
      },
      "name": "Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "executeOnce": true,
      "id": "1d3bd116-3941-4f4a-a02c-719c6507a753"
    },
    {
      "parameters": {
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash?key={{ $env.GEMINI_API_KEY }}",
        "options": {}
      },
      "name": "Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        0
      ],
      "executeOnce": true,
      "id": "43464a71-b0ae-47a5-8a92-b0c8fef87d6d"
    },
    {
      "parameters": {
        "url": "=https://api.airtable.com/v0/{{ $env.AIRTABLE_BASE_ID }}/Jogos?maxRecords=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.AIRTABLE_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Airtable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        0
      ],
      "executeOnce": true,
      "id": "61207e87-f8b8-4060-91d6-dcf3f47b15db"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: {\n  timezone: $env.GENERIC_TIMEZONE,\n  agora: $now.toFormat('yyyy-MM-dd HH:mm ZZZZ'),\n  jogos_hoje: $('FootballData').first().json.matches.length,\n  telegram_chat: $('Telegram').first().json.result.type,\n  gemini_modelo: $('Gemini').first().json.name,\n  airtable_registros: ($('Airtable').first().json.records || []).length\n} }];"
      },
      "name": "Resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "executeOnce": true,
      "id": "0fa9a5c0-2f56-45eb-98df-20abdc137aa8"
    }
  ],
  "connections": {
    "Start": {
